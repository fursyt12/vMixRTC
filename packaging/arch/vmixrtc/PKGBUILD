# Maintainer: fursyt12 <yt.wilde.simon@gmail.com>
#
# Сборка vMixRTC из исходников (тег rust-v$pkgver).
# Всё, что нужно для сборки, уже есть в дереве: статический интерфейс лежит в
# crates/vmixrtc/ui и попадает в бинарь через tauri::generate_context! — поэтому
# tauri-cli, node и npm не требуются, достаточно cargo.
#
# Обновление версии:
#   1. поднять pkgver, сбросить pkgrel=1;
#   2. updpkgsums
#   3. makepkg --syncdeps --cleanbuild   # локальная проверка сборки
#   4. makepkg --printsrcinfo > .SRCINFO
#   5. git push в AUR (ssh://aur@aur.archlinux.org/vmixrtc.git)

pkgname=vmixrtc
pkgver=0.1.5
pkgrel=1
pkgdesc="Cross-platform vMix title controller (widgets, scripts, data providers, NDI)"
arch=('x86_64' 'aarch64')
url="https://github.com/fursyt12/vMixRTC"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'alsa-lib'
  'systemd-libs'
)
makedepends=(
  'rust'
  'cargo'
  'pkgconf'
)
optdepends=(
  'ndi-sdk: приём NDI и список источников (проприетарный runtime, в репозиториях Arch нет)'
)
conflicts=('vmixrtc-bin')
# !lto: makepkg добавляет «-flto=auto» в CFLAGS, а C-часть crate ring собирается
# через cc — LTO-объекты потом не линкуются с Rust-кодом (undefined ring_core_*).
options=('!debug' '!lto')

source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/rust-v${pkgver}.tar.gz")

sha256sums=('abcc38dcf803b6ffa8a5e41284d4e16dcb914ff3932a7eaf6d84bf7d3070ce86')

prepare() {
  cd "vMixRTC-rust-v$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  # зависимости тянем один раз здесь; сборка идёт офлайн
  cargo fetch --locked
}

build() {
  cd "vMixRTC-rust-v$pkgver"
  export CARGO_HOME="$srcdir/cargo-home"
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --locked -p vmixrtc -p vmixrtc-cli
}

package() {
  cd "vMixRTC-rust-v$pkgver"

  # приложение и консольная утилита
  install -Dm755 target/release/vmixrtc "$pkgdir/usr/bin/vmixrtc"
  install -Dm755 target/release/vmixrtc-cli "$pkgdir/usr/bin/vmixrtc-cli"

  # ярлык и иконки
  install -Dm644 packaging/linux/vmixrtc.desktop \
    "$pkgdir/usr/share/applications/vmixrtc.desktop"
  install -Dm644 crates/vmixrtc/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/vmixrtc.png"
  install -Dm644 crates/vmixrtc/icons/64x64.png \
    "$pkgdir/usr/share/icons/hicolor/64x64/apps/vmixrtc.png"
  install -Dm644 crates/vmixrtc/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/vmixrtc.png"
  install -Dm644 crates/vmixrtc/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256@2/apps/vmixrtc.png"
  install -Dm644 crates/vmixrtc/icons/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/vmixrtc.png"

  # каталоги функций vMix — приложение ищет их в /usr/share/vmixrtc
  install -Dm644 data/Functions.xml "$pkgdir/usr/share/vmixrtc/Functions.xml"
  install -Dm644 data/NewFunctions.xml "$pkgdir/usr/share/vmixrtc/NewFunctions.xml"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
